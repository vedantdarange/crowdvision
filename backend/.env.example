# Crowd Safety Monitor — backend environment variables
# Copy to backend/.env and fill in real values.
# This file is committed; .env is git-ignored. Never commit secrets.

# --- Flask ---
FLASK_ENV=development
# SECRET_KEY is used by Flask session signing (not JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret

# --- Database ---
DATABASE_URL=sqlite:///instance/app.db

# --- Detection ---
MODEL_PATH=docs/model/best.pt
# DETECTOR_BACKEND: "fake" (no torch, used in tests/CI) or "ultralytics"
DETECTOR_BACKEND=fake

# --- VAPID (Web Push) — B6 ---
# Generate: vapid --gen  (py-vapid)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Frontend serving (demo mode) ---
SERVE_FRONTEND=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Demo / seed ---
# DEMO_CENTER: lat,lng of your demo venue (used by seed script for zone polygons)
DEMO_CENTER=28.6139,77.2090

# SEED_PASSWORD: shared password for all seed accounts in local dev.
# If unset, seed-demo generates a random password per account and prints once.
# .env.example sets Demo@1234 for local development ONLY — never use in a demo
# exposed to the internet without changing it.
SEED_PASSWORD=Demo@1234

# ALLOW_DEFAULT_PASSWORDS: set true to skip the startup default-password check
# (dangerous — only for local dev without SERVE_FRONTEND=true)
ALLOW_DEFAULT_PASSWORDS=false

# --- Proxy (tunnel / reverse-proxy) ---
# Set to 1 behind cloudflared tunnel so rate limits key on the real client IP.
# Set to 0 for direct localhost dev.
TRUSTED_PROXY_COUNT=0

# --- Engine settings (can also be edited at runtime via /api/v1/settings) ---
USE_TRACKER=false
REPORT_RETENTION_DAYS=30
