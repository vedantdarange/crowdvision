{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@contract/*": ["../contract/*"]
    }
  },
  "include": [
    "src",
    "mock-server",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "../contract/types.ts"
  ],
  "exclude": ["src/sw.ts"]
}
